# Copie para .env com `./scripts/vetor.sh init-env` (gera segredos aleatórios). Nunca versione o .env.
TAIGA_SCHEME=http
TAIGA_DOMAIN=localhost:9000
SUBPATH=""
WEBSOCKETS_SCHEME=ws
VETOR_HTTP_PORT=9000
# Código-fonte e créditos (obrigação da AGPL-3.0 do taiga-front): link do menu Ajuda.
VETOR_SOURCE_URL=https://github.com/omnihive66/crmvetor#cr%C3%A9ditos-e-licen%C3%A7as
# True em produção (HTTPS); False apenas em desenvolvimento local sem HTTPS.
COOKIES_SECURE=False

SECRET_KEY=CHANGE_ME
POSTGRES_USER=taiga
POSTGRES_PASSWORD=CHANGE_ME

# console: e-mails aparecem no log (desenvolvimento). smtp: envio real.
EMAIL_BACKEND=console
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_DEFAULT_FROM=nao-responda@example.com
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

RABBITMQ_USER=taiga
RABBITMQ_PASS=CHANGE_ME
RABBITMQ_VHOST=taiga
RABBITMQ_ERLANG_COOKIE=CHANGE_ME

ATTACHMENTS_MAX_AGE=360
# Telemetria anônima do Taiga (envia dados à Kaleidos). Desligada por padrão.
ENABLE_TELEMETRY=False

# CRM (SPEC-03): limite de upload de documentos e o sistema financeiro/contratual externo (nome a confirmar).
VETOR_DOCUMENTO_MAX_MB=25
VETOR_SISTEMA_FINANCEIRO_NOME=
# Use {codigo} para o código do cliente, ex.: https://financeiro.exemplo/clientes/{codigo}
VETOR_SISTEMA_FINANCEIRO_URL=

# GitHub (SPEC-06): segredo do webhook (o mesmo cadastrado no GitHub). Vazio = integração desligada.
# Gere com: openssl rand -hex 32. Para trocar, mova o atual para _ANTERIOR, ponha o novo, atualize o GitHub e esvazie _ANTERIOR.
VETOR_GITHUB_WEBHOOK_SECRET=
VETOR_GITHUB_WEBHOOK_SECRET_ANTERIOR=

# Monitoramento (SPEC-07): Uptime Kuma e Beszel não assinam webhooks; enviam o cabeçalho X-Vetor-Token com este valor.
# Vazio = conector desligado. Gere com: openssl rand -hex 32. Rotação como no GitHub (_ANTERIOR vale durante a troca).
VETOR_KUMA_TOKEN=
VETOR_KUMA_TOKEN_ANTERIOR=
VETOR_BESZEL_TOKEN=
VETOR_BESZEL_TOKEN_ANTERIOR=
# Reincidência dentro da janela reabre o incidente; e-mail ao dono do projeto no máximo a cada AVISO_MIN; retenção do conteúdo bruto.
VETOR_MONITOR_JANELA_MIN=15
VETOR_MONITOR_AVISO_MIN=30
VETOR_MONITOR_RETENCAO_DIAS=90

# Adoção (SPEC-08): eventos de uso (pseudonimizados) mais antigos que isto são apagados.
VETOR_USO_RETENCAO_DIAS=180

# Financeiro (SPEC-09): fechado. Só o(s) usuário(s) matriz listados aqui (login, separados por vírgula) consultam e alteram custos.
# Vazio = ninguém. Não há opção na tela para liberar outras pessoas.
VETOR_FINANCEIRO_USUARIOS=

# Backup (SPEC-10): arquivo com a chave que cifra banco, anexos e .env no backup (AES-256). Fica FORA do repositório
# e do diretório de backups; guarde uma cópia offline (sem ela o backup não restaura). Gere: openssl rand -base64 48 > /caminho/chave
VETOR_BACKUP_CHAVE_ARQUIVO=
# Alerta se o último backup bem-sucedido for mais velho que isto (horas).
VETOR_BACKUP_MAX_HORAS=26
